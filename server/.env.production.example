# Production values for the API on raw.neuralwebworks.com.
# Copy to .env on the server. Never commit the real file.

# Hostinger injects the port it wants the app to listen on. Leave this unset
# in a managed Node app; set it only if you control the port (VPS).
# PORT=4000

# Browsers enforce this: only these origins may POST a brief. The front end is
# served from the bare domain, and the .htaccess redirects www to it, but list
# both so a request in flight during a redirect is not rejected.
CORS_ORIGIN=https://neuralwebworks.com,https://www.neuralwebworks.com

# Required to read stored leads via GET /api/leads (x-admin-key header).
# Generate a real one, e.g.  node -e "console.log(crypto.randomUUID())"
ADMIN_KEY=replace-with-a-long-random-string

# Where leads.json and leads.csv are written, relative to server/ or absolute.
# Point this outside the deploy directory so a redeploy cannot erase leads.
DATA_DIR=../data
