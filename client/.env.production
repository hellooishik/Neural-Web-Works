# Production build config. Vite inlines these at build time, so anything here
# is public — never put a secret in this file.
#
# The site is served from neuralwebworks.com and the API from a separate
# subdomain, so requests need an absolute base. No trailing slash: api.js
# appends "/api/brief" itself.
VITE_API_BASE=https://raw.neuralwebworks.com
