# Neural Web Works — Apache/LiteSpeed config for the static front end.
# Vite copies everything in public/ to dist/, so this ships with the build.

# ---------------------------------------------------------------- HTTPS + host
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS.
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Canonical host: send www to the bare domain.
  RewriteCond %{HTTP_HOST} ^www\.neuralwebworks\.com$ [NC]
  RewriteRule ^ https://neuralwebworks.com%{REQUEST_URI} [L,R=301]

  # Single-page app: serve real files as-is, send everything else to index.html.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]
</IfModule>

# ------------------------------------------------------------------- caching
# Vite fingerprints filenames in assets/, so those are safe to cache forever.
# index.html must never be cached or visitors keep the old asset references.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Baseline hardening.
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# ------------------------------------------------------------------ compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>

# Do not hand out directory listings.
Options -Indexes
